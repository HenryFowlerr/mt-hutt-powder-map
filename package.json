{
  "name": "mt-hutt-powder-map",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "fetch:terrain": "tsx scripts/fetch-opentopo-terrain.ts",
    "fetch:trails": "tsx scripts/fetch-osm-trails.ts",
    "update:data": "tsx scripts/fetch-weather.ts && tsx scripts/build-powder-grid.ts",
    "test:data": "tsx scripts/check-data-integrity.ts",
    "test:model": "tsx scripts/check-powder-model.ts && tsx scripts/test-weather-time.ts && tsx scripts/check-recent-terrain-signal.ts",
    "test:confidence": "tsx scripts/check-forecast-confidence.ts && tsx scripts/test-ensemble-summary.ts",
    "test:update-pipeline": "tsx scripts/test-weather-update-failures.ts",
    "test:bundle": "tsx scripts/check-bundle-budget.ts",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@meteocons/svg": "^0.1.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "d3-scale": "^4.0.2",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
